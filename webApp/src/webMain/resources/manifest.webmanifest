{
  "id": "./",
  "name": "KBBI — Kamus Besar Bahasa Indonesia",
  "short_name": "KBBI",
  "description": "Cari arti kata dalam bahasa Indonesia.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#193c8f",
  "icons": [
    { "src": "icon-192.svg", "sizes": "192x192", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-512.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Kata hari ini", "short_name": "Hari ini", "url": "./#/widget/word-of-day", "icons": [{ "src": "icon-192.svg", "sizes": "192x192" }] },
    { "name": "Cari kata", "short_name": "Cari", "url": "./#/widget/quick-search", "icons": [{ "src": "icon-192.svg", "sizes": "192x192" }] },
    { "name": "Kata tersimpan", "short_name": "Tersimpan", "url": "./#/widget/saved-word", "icons": [{ "src": "icon-192.svg", "sizes": "192x192" }] },
    { "name": "Peribahasa", "short_name": "Peribahasa", "url": "./#/proverb", "icons": [{ "src": "icon-192.svg", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "share_text", "url": "url" }
  }
}
